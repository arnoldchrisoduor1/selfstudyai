FROM rust:1.90-bookworm AS build
WORKDIR /src
COPY Cargo.toml Cargo.lock rustfmt.toml clippy.toml ./
COPY crates ./crates
COPY apps/desktop/src-tauri ./apps/desktop/src-tauri
# LTO + one codegen unit OOMs a 1 GB droplet. Keep release opts, skip fat LTO.
ENV CARGO_PROFILE_RELEASE_LTO=false \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=8
RUN cargo build --release -p api

FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/target/release/api /usr/local/bin/api
ENV APP_ENV=production \
    RUST_LOG=info \
    API_HOST=0.0.0.0 \
    API_PORT=8080 \
    DATABASE_URL=sqlite:///data/selfstudy.db
VOLUME /data
EXPOSE 8080
CMD ["api"]
